{
  "name": "runcell",
  "version": "1.12.1",
  "description": "TypeScript runtime for running agents in sandboxes with structured results, file outputs, and persistent threads.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js",
      "default": "./dist/pi.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "del-cli dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:live": "vitest --run --config vitest.live.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@ai-sdk/sandbox-vercel": "1.0.154",
    "@napi-rs/canvas": ">=1",
    "pdfjs-dist": ">=5"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.154",
    "@ai-sdk/provider-utils": "5.0.62",
    "@ai-sdk/sandbox-just-bash": "1.0.154",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@standard-schema/spec": "^1.1.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/sandbox-vercel": "1.0.154",
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^26.6.5",
    "ai": "7.0.143",
    "del-cli": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "ai",
    "agent",
    "agent-runtime",
    "sandbox",
    "sandboxed-agents",
    "code-execution",
    "structured-output",
    "typescript",
    "llm",
    "ai-agents",
    "standard-schema",
    "zod"
  ],
  "peerDependenciesMeta": {
    "@ai-sdk/sandbox-vercel": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D4NZ-jpg/runcell.git"
  },
  "homepage": "https://runcell.run/",
  "bugs": {
    "url": "https://github.com/D4NZ-jpg/runcell/issues"
  }
}
